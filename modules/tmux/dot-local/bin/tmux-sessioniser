#!/usr/bin/env bash

switch_to() {
    local session_name="${1}"

    if [[ -z ${TMUX} ]]; then
        tmux attach-session -t "${session_name}"
    else
        tmux switch-client -t "${session_name}"
    fi
}

hydrate() {
    local selected_name="${1}"
    local selected="${2}"

    config_dir=$HOME/.config
    if [ ! -z "${XDG_CONFIG_HOME}" ]; then
        config_dir="${XDG_CONFIG_HOME}"
    fi

    if [ -f "${selected}/.tmux-sessioniser" ]; then
        tmux send-keys -t "${selected_name}" "source ${selected}/.tmux-sessioniser" c-M
    elif [ -f "${config_dir}/tmux-sessioniser/config" ]; then
        tmux send-keys -t "${selected_name}" "source ${config_dir}/tmux-sessioniser/config" c-M
    else
        tmux send-keys -t "${selected_name}" "nvim ${selected}" c-M
        tmux new-window -t "${selected_name}" -c "${selected}"
        tmux new-window -t "${selected_name}" -c "${selected}"
        tmux select-window -t "${selected_name}:1"
    fi
}

if [[ $# -eq 1 ]]; then
    selected="${1}"
else
    if command -v xdg-user-dir >/dev/null 2>&1; then
        project_dir="$(xdg-user-dir PROJECTS)"
    else
        project_dir="${HOME}/Projects"
    fi

    selected=$(find "${project_dir}" -mindepth 2 -maxdepth 6 -type d -name '.git' | sed -r 's|/[^/]+$||' | fzf)
fi

if [[ -z "${selected}" ]]; then
    exit 0
fi

selected_name=$(basename "${selected}" | tr . _)

if ! tmux has-session -t="${selected_name}" 2> /dev/null; then
    tmux new-session -ds "${selected_name}" -c "${selected}"
    hydrate "${selected_name}" "${selected}"
fi

switch_to "${selected_name}"
